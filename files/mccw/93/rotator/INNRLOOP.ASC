; The picture is stored at #0000 and has dimensions (256, ??)
; One byte is one pixel
; VRAM write is set to the correct address
; B is the number of horizontal pixels
; C is #98
; HL is x
; DE is xh
; HL' is y
; DE' is yh

LOOP:
 ADD HL,DE ; X=X+XH
 LD A,H
 EXX
 ADD HL,DE ; Y=Y+YH
 LD C,L 
 LD B,A
 LD A,(BC)
 EXX
 OUT (C),A
 DJNZ LOOP
