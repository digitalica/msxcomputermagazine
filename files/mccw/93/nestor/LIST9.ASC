'///
'/// List 9: Getting palette data information with GETPLT
'///

@define COLOR c
@define RED r
@define GREEN g
@define BLUE b

@define BIOS	e=usr(58)
@define GETPLT	&H149

'GETPLT works in the following way:
'Input:  A = Color to get information for (p(2)=AF)
'Output: BC = p(4) = GREEN + 256*BLUE + 4096*RED

~	@COLOR= 7	'Sample color
	p(0)= 1:	'Now we call SUB-BIOS
	p(1)= @GETPLT:
	p(2)= @COLOR*256:
	@BIOS:

	@RED= (p(3)\4096) and 15:
	@GREEN= p(3) and 15:
	@BLUE= (p(3)\256) and 15:
	print @COLOR; "="; @RED, @GREEN, @BLUE
