---
// Plain Markdown pages. Pages that also render data (art-gallery,
// mcm-verzameldisks) or replace the 404 (oeps) have their own templates.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const OWN_TEMPLATE = new Set(['art-gallery', 'mcm-verzameldisks', 'oeps']);
  const pages = await getCollection('pages', (p) => !OWN_TEMPLATE.has(p.id));
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base title={page.data.title}>
  <article class="prose" data-pagefind-body>
    <h1>{page.data.title}</h1>
    <Content />
  </article>
</Base>

<style>
  /* Pages without an intro of their own (contact): the first paragraph is
     the intro. */
  article:not(:has(.lead)) :global(> p:first-of-type) {
    font-size: 1.125rem;
    line-height: 1.65;
  }
</style>
