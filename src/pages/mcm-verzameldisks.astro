---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import disks from '../data/verzameldisks.json';
import { webmsxUrl } from '../lib/links';

const page = (await getEntry('pages', 'mcm-verzameldisks'))!;
const { Content } = await render(page);

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/verzameldisks/*', { eager: true });
const img = (file: string) => images[`../assets/verzameldisks/${file}`].default;
// The photos are large scans; link to a resized copy.
const photos = Object.fromEntries(
  await Promise.all(disks.map(async (d) => [d.photo, (await getImage({ src: img(d.photo), width: 1600 })).src])),
);
---

<Base title={page.data.title} description="De MCM verzameldiskettes: de beste spellen, utilities, toepassingen en Art Gallery-schermen.">
  <article class="prose" data-pagefind-body>
    <h1>{page.data.title}</h1>
    <Content />
  </article>

  <ul class="disks">
    {
      disks.map((disk) => (
        <li>
          <a href={photos[disk.photo]} target="_blank" class="thumb">
            <Image src={img(disk.thumb)} alt={`Diskette ${disk.name}`} width={120} />
          </a>
          <div>
            <h2 class="mono">{disk.name}</h2>
            <p set:html={disk.description} />
            <a class="btn btn-primary" href={webmsxUrl(disk.webmsx)} target="_blank">
              ▶ Start in WebMSX
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .disks {
    display: grid;
    gap: 1rem;
    max-width: 52rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .disks li {
    display: flex;
    gap: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }

  .thumb {
    flex: none;
  }

  .thumb img {
    width: 120px;
    border-radius: 3px;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
  }

  p {
    margin: 0.4rem 0 0.75rem;
  }

  @media (max-width: 30rem) {
    .disks li {
      flex-direction: column;
    }
  }
</style>
