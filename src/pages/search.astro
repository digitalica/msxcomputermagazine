---
import Base from '../layouts/Base.astro';
---

<Base title="Zoeken" description="Doorzoek het MSX Computer Magazine archief: nummers, listings en disks.">
  <h1>Doorzoek het archief</h1>
  <p class="muted intro">
    Zoek op titel van een listing, programma of disk. Voor artikelen in MCM 1 t/m 50 kun je ook de{' '}
    <a href="/index1-50/">index</a> gebruiken.
  </p>
  <div id="search"></div>
  <noscript><p>Zoeken werkt alleen met JavaScript aan.</p></noscript>
</Base>

<!-- Generated by `pagefind` after `astro build`; `astro dev` serves the one from the last build. -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI === 'undefined') {
      document.querySelector('#search').innerHTML =
        '<p class="muted">De zoekindex ontbreekt: die wordt gemaakt door <code>pnpm build</code>.</p>';
      return;
    }
    const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  });
</script>

<style>
  .intro {
    max-width: var(--narrow);
  }

  #search {
    max-width: var(--narrow);
    margin-top: 1.5rem;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--card);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--paper-2);
    --pagefind-ui-font: var(--font);
  }
</style>
