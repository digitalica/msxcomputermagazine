---
import { Image } from 'astro:assets';
import { issueUrl, type Issue } from '../lib/archive';

interface Props {
  issues: Issue[];
  /** Load the first few covers eagerly (top of the page). */
  eager?: number;
}

const { issues, eager = 0 } = Astro.props;
---

<ul class="issue-grid">
  {
    issues.map((issue, i) => (
      <li>
        <a href={issueUrl(issue)}>
          <Image
            src={issue.data.cover}
            alt={`Cover ${issue.data.title}`}
            widths={[180, 360]}
            sizes="(max-width: 480px) 45vw, 180px"
            loading={i < eager ? 'eager' : 'lazy'}
          />
          <span>{issue.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .issue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 1.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  img {
    width: 100%;
    aspect-ratio: 475 / 675;
    object-fit: cover;
    border-radius: 3px;
    background: var(--paper-2);
    box-shadow: var(--shadow);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  a:hover img,
  a:focus-visible img {
    transform: translateY(-8px) scale(1.05);
    box-shadow:
      0 6px 12px rgb(0 0 0 / 0.18),
      0 18px 36px rgb(0 0 0 / 0.22);
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      transition: box-shadow 0.2s ease;
    }

    a:hover img,
    a:focus-visible img {
      transform: none;
    }
  }

  a:hover span {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (max-width: 30rem) {
    .issue-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem 1rem;
    }
  }
</style>
